# Bharat Onboarding — Backend Environment Variables
# Copy this file to .env and fill in your keys

# Main Gemini API key (used for text tasks: validation, explain, chat, product title)
GEMINI_API_KEY=your_gemini_api_key_here

# Dedicated Gemini Vision key (used for image verification in seller onboarding)
GEMINI_VISION_KEY=your_gemini_vision_key_here

PORT=4000

# MongoDB connection string
# Local dev: mongodb://127.0.0.1:27017/bharat_onboarding
# Atlas:     mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bharat_onboarding
MONGODB_URI=mongodb://127.0.0.1:27017/bharat_onboarding
